{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["node", "@cucumber/cucumber"]
  },
  "include": ["pages/**/*.ts", "steps/**/*.ts", "support/**/*.ts", "utils/**/*.ts", "feature/**/*.feature", "stepdefinition/**/*.ts", "utils/**/*.ts", "stepdefinition/fan.steps.ts"],
  "exclude": ["node_modules"]
}